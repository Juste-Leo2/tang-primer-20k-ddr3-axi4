package build
import mill._
import mill.scalalib._
import java.io.File

object ddr3 extends ScalaModule {
  def scalaVersion = "2.12.18"

  // Repo-anchored tools dir: moduleDir is <repo>/ddr3 regardless of the
  // mill daemon's cwd (user.dir) or inherited env, so this candidate
  // always resolves the in-tree oss-cad-suite from setup.bat.
  val repoToolsDir = (moduleDir / os.up / "tools" / "oss-cad-suite").toString.replace('\\', '/')
  // Same for w64devkit (sh/make/gcc used by Verilator C++ builds in unit
  // tests). setup.bat installs it into tools/w64devkit.
  val repoW64BinDir = (moduleDir / os.up / "tools" / "w64devkit" / "bin").toString.replace('\\', '/')

  override def mvnDeps = Seq(
    mvn"com.github.spinalhdl::spinalhdl-core:1.15.0",
    mvn"com.github.spinalhdl::spinalhdl-lib:1.15.0"
  )

  override def scalacPluginMvnDeps = Seq(mvn"com.github.spinalhdl::spinalhdl-idsl-plugin:1.15.0")

  object test extends ScalaTests with TestModule.ScalaTest {
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.scalatest::scalatest:3.2.17"
    )
    // Unit sim tests (test/src) + formal proofs (test/formal, sby).
    override def sources = Task.Sources(moduleDir / "src", moduleDir / "formal")
    override def forkArgs = super.forkArgs() ++ Seq("-Xss512m")

    override def forkEnv = {
      val userHome = System.getProperty("user.home").replace('\\', '/')
      val repoDir = System.getProperty("user.dir").replace('\\', '/')

      val ossCandidates = Seq(
        sys.env.getOrElse("OSS_CAD_SUITE_HOME", ""),
        ddr3.repoToolsDir,
        s"$repoDir/tools/oss-cad-suite",
        s"$userHome/.spinalml_tools/oss-cad-suite"
      ).filter(_.nonEmpty)

      val foundOss = ossCandidates.find(p => new File(p, "bin").exists())

      val extraEnv = foundOss match {
        case Some(oss) =>
          val verilatorRoot = s"$oss/share/verilator"
          val ossBin = s"$oss/bin"
          // Mirror oss-cad-suite/environment.ps1: both bin AND lib on PATH,
          // otherwise yosys/sby/solvers crash with 0xC0000135 (missing
          // libstdc++/libwinpthread/libffi/libpython DLLs).
          val ossLib = s"$oss/lib"
          // sh/make/gcc for Verilator: in-tree w64devkit first (setup.bat),
          // then legacy user location. Non-existent entries are harmless in
          // PATH; the first existing one wins for sh.exe resolution.
          val w64Candidates = Seq(
            ddr3.repoW64BinDir,
            s"$userHome/.spinalml_tools/w64devkit/bin"
          ).filter(p => new File(p, "sh.exe").exists())
          val w64Bin = w64Candidates.headOption.getOrElse(s"$userHome/.spinalml_tools/w64devkit/bin")
          val currentPath = sys.env.getOrElse("PATH", "")
          val newPath = s"$ossBin;$ossLib;$w64Bin;$currentPath"
          Map("VERILATOR_ROOT" -> verilatorRoot, "PATH" -> newPath)
        case None =>
          Map.empty[String, String]
      }

      super.forkEnv() ++ extraEnv
    }
  }
}
